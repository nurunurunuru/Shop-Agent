PORT=3000

# (ঐচ্ছিক, বিক্রির সময় দরকারি) সেটআপ কোড দিলে প্রথম অ্যাকাউন্ট খুলতে এই কোড লাগবে।
# সার্ভার ইন্টারনেটে চালুর পর অন্য কেউ আগে ঢুকে মালিক হয়ে যাওয়া ঠেকায়।
SETUP_CODE=

# আপনার public URL (ngrok বা Render), শেষে / দেবেন না। প্রোডাক্টের ছবি Meta-কে পাঠাতে এটা লাগে।
PUBLIC_URL=https://your-url.ngrok-free.dev

# Meta webhook verify token (আপনি যেটা Meta-তে দিয়েছেন)
VERIFY_TOKEN=myshop2026secret

# Facebook Page token (Instagram-এও এটাই চলে)
PAGE_ACCESS_TOKEN=
IG_ACCESS_TOKEN=

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Gemini (ফ্রি)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# মূল মডেল ব্যস্ত/বন্ধ হলে এই মডেলগুলোতে নিজে সরে যায় (কমা দিয়ে একাধিক)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite

GRAPH_VERSION=v25.0

# কুরিয়ার: mock (টেস্ট) অথবা steadfast
COURIER_MODE=mock
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# Steadfast Webhook: panel → Webhook settings-এ Callback URL = আপনার-ডোমেইন/steadfast/webhook, তারপর "Generate" চেপে পাওয়া Auth token এখানে দিন।
STEADFAST_WEBHOOK_TOKEN=

# Steadfast-এর সরাসরি ট্র্যাকিং লিংকের ধরন জানলে দিন ({code} = ট্র্যাকিং কোড, {cid} = কনসাইনমেন্ট আইডি)।
# না দিলে কাস্টমারকে কোড + steadfast.com.bd/tracking পাঠানো হয়।
TRACK_URL_TEMPLATE=

# ডেটা (অর্ডার, চ্যাট, ছবি) রাখার ফোল্ডার। Render-এ ডিস্ক লাগালে এখানে ডিস্কের পথ দিন (যেমন /var/data)।
DATA_DIR=

# ছবি স্থায়ীভাবে রাখতে Cloudinary (ফ্রি)। Render-এ ডিস্ক না থাকলে এটা দিন, নইলে রিস্টার্টে ছবি মুছে যায়।
# Cloudinary Dashboard → "API Environment variable" থেকে কপি করুন:
CLOUDINARY_URL=
