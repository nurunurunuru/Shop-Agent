# ===== সার্ভার =====
PORT=3000
# আপনার public https URL (Render বা ngrok), শেষে / দেবেন না। Meta webhook, ছবি পাঠানো, Facebook লগইন সবকিছুর জন্য লাগে।
PUBLIC_URL=https://your-app.onrender.com

# ===== ডেটাবেস (প্রোডাকশনে অবশ্যই দিন, নইলে রিস্টার্টে ডেটা মুছে যায়) =====
MONGODB_URI=
# MONGODB_DB=shopagent

# ===== Meta App (একবারই বসাবেন, সব দোকানদার এটা দিয়ে কানেক্ট করবে) — বিস্তারিত: META-SETUP.md =====
META_APP_ID=
META_APP_SECRET=
# (ঐচ্ছিক) পুরোনো Meta App এখনো এই সার্ভারে webhook পাঠালে তার সিক্রেট এখানে দিন, নইলে সেই মেসেজ ফেরত যাবে
META_APP_SECRET_OLD=
# Meta-তে Webhook বসানোর সময় যে verify token দেবেন (যেকোনো গোপন শব্দ)
VERIFY_TOKEN=
# "Facebook Login for Business" কনফিগারেশন ID: Facebook পেজ + Instagram কানেক্টের জন্য
META_FB_CONFIG_ID=
# (ঐচ্ছিক) config ID না থাকলে কোন permission চাওয়া হবে (কমা দিয়ে)। Meta "Invalid Scopes" বললে এখানে বাদ দিয়ে দিন।
META_FB_SCOPES=
# WhatsApp Embedded Signup কনফিগারেশন ID (WhatsApp কানেক্টের জন্য; না দিলে শুধু WhatsApp বাটন বন্ধ থাকবে)
META_WA_CONFIG_ID=
# (ঐচ্ছিক) Tech Provider / Solution ID, যদি Meta দিয়ে থাকে
META_WA_SOLUTION_ID=
GRAPH_VERSION=v25.0

# ===== সাইন-আপ =====
# ALLOW_SIGNUP=0 দিলে নতুন দোকান খোলা বন্ধ। SIGNUP_CODE দিলে সাইন-আপে এই কোড লাগবে (শুধু আমন্ত্রিতদের জন্য)।
ALLOW_SIGNUP=1
SIGNUP_CODE=

# ===== AI (সব দোকানের জন্য একই; খরচ আপনার) =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
GROQ_API_KEY=

# ===== ছবি রাখা (Render-এ রিস্টার্টে ছবি মুছে না যাওয়ার জন্য) =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== শুধু আগের এক-দোকানের সেটআপ থেকে আসলে =====
# নতুন দোকানদাররা এগুলো লাগবে না: তারা "কানেক্ট" ট্যাব ও নিজের Steadfast key ব্যবহার করে।
# এই মানগুলো থাকলে আপনার পুরোনো দোকান আগের মতোই চলবে।
# PAGE_ACCESS_TOKEN=
# IG_ACCESS_TOKEN=
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# COURIER_MODE=steadfast
# STEADFAST_API_KEY=
# STEADFAST_SECRET_KEY=
# STEADFAST_WEBHOOK_TOKEN=
